generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PROFESSIONAL
  ADMIN
}

enum ProfessionalCategory {
  HOTEL
  RESTAURANT
  EVENT
  VENUE
  PHOTOGRAPHY
  BEAUTY
  VEHICLE
  TRANSPORT
  MECHANIC
  TECHNICIAN
  ARTISAN
  OTHER
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  SASPAY
}

enum SubscriptionPlan {
  BASIC
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  PAID
  REJECTED
}

enum WalletTransactionType {
  BOOKING_REVENUE
  WITHDRAWAL
  WITHDRAWAL_REFUND
  REFUND
  ADJUSTMENT
}

enum CustomFieldType {
  TEXT
  NUMBER
  PHONE
  EMAIL
  SELECT
  CHECKBOX
}

enum NotificationType {
  BOOKING
  PAYMENT
  WITHDRAWAL
  SUBSCRIPTION
  SYSTEM
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String   @unique
  passwordHash String
  role         UserRole @default(PROFESSIONAL)

  profile      ProfessionalProfile?
  notifications Notification[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
}

model ProfessionalProfile {
  id          String @id @default(cuid())
  userId      String @unique

  businessName String
  slug         String @unique
  category     ProfessionalCategory
  description  String?

  address      String?
  city         String
  country      String @default("Togo")

  contactEmail String?
  contactPhone String?

  isPublished  Boolean @default(false)
  blueBadgeAt  DateTime?

  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  services      Service[]
  bookings      Booking[]
  wallet        Wallet?
  subscriptions Subscription[]
  reviews       Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, city])
  @@index([isPublished])
}

model Service {
  id          String @id @default(cuid())
  profileId   String

  name        String
  description String?
  price       Int
  currency    String @default("XOF")

  durationMinutes Int?
  capacity        Int @default(1)

  isActive    Boolean @default(true)

  profile       ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  availabilities ServiceAvailability[]
  blockedPeriods ServiceBlockedPeriod[]
  customFields  CustomField[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId, isActive])
}

model ServiceAvailability {
  id        String @id @default(cuid())
  serviceId String

  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean @default(true)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, dayOfWeek])
}

model ServiceBlockedPeriod {
  id        String @id @default(cuid())
  serviceId String

  startsAt DateTime
  endsAt   DateTime
  reason   String?

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, startsAt, endsAt])
}

model Booking {
  id          String @id @default(cuid())
  reference   String @unique

  profileId   String
  serviceId   String

  customerFirstName String
  customerLastName  String
  customerPhone     String
  customerEmail     String

  startsAt    DateTime
  endsAt      DateTime?

  quantity    Int @default(1)
  amount      Int
  currency    String @default("XOF")

  status      BookingStatus @default(PENDING_PAYMENT)

  qrToken     String? @unique
  qrUsedAt    DateTime?
  completedAt DateTime?

  profile     ProfessionalProfile @relation(fields: [profileId], references: [id])
  service     Service @relation(fields: [serviceId], references: [id])
  payment     Payment?
  review      Review?
  fieldValues BookingFieldValue[]
  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId, startsAt])
  @@index([serviceId, startsAt])
  @@index([status])
}

model Payment {
  id String @id @default(cuid())

  bookingId String @unique
  provider  PaymentProvider @default(SASPAY)

  providerPaymentId String? @unique
  amount            Int
  currency          String @default("XOF")

  status PaymentStatus @default(PENDING)

  network       String?
  customerPhone String?

  paidAt       DateTime?
  verifiedAt   DateTime?

  booking Booking @relation(fields: [bookingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Review {
  id          String @id @default(cuid())

  profileId   String
  bookingId   String @unique

  rating      Int
  comment     String?

  profile     ProfessionalProfile @relation(fields: [profileId], references: [id])
  booking     Booking @relation(fields: [bookingId], references: [id])

  createdAt DateTime @default(now())

  @@index([profileId, rating])
}

model Wallet {
  id        String @id @default(cuid())
  profileId String @unique

  availableBalance Int @default(0)
  pendingBalance   Int @default(0)
  totalEarned      Int @default(0)
  totalWithdrawn   Int @default(0)

  profile      ProfessionalProfile @relation(fields: [profileId], references: [id])
  transactions WalletTransaction[]
  withdrawals  Withdrawal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id       String @id @default(cuid())
  walletId String

  bookingId String?

  type        WalletTransactionType
  amount      Int
  description String?
  reference   String @unique

  wallet  Wallet @relation(fields: [walletId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
}

model Withdrawal {
  id       String @id @default(cuid())
  walletId String

  reference String @unique
  amount    Int

  firstName  String
  lastName   String
  phone      String
  operator   String

  status WithdrawalStatus @default(PENDING)

  adminNote String?
  processedAt DateTime?

  wallet Wallet @relation(fields: [walletId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model Subscription {
  id        String @id @default(cuid())
  profileId String

  plan      SubscriptionPlan
  status    SubscriptionStatus @default(ACTIVE)

  amount    Int
  startsAt  DateTime
  expiresAt DateTime

  profile ProfessionalProfile @relation(fields: [profileId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId, status])
}

model CustomField {
  id        String @id @default(cuid())
  serviceId String

  label     String
  type      CustomFieldType
  required  Boolean @default(false)
  options   Json?

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  values  BookingFieldValue[]

  createdAt DateTime @default(now())
}

model BookingFieldValue {
  id            String @id @default(cuid())
  bookingId     String
  customFieldId String

  value String

  booking     Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customField CustomField @relation(fields: [customFieldId], references: [id])

  @@unique([bookingId, customFieldId])
}

model Notification {
  id     String @id @default(cuid())
  userId String

  title   String
  message String
  type    NotificationType
  isRead  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
}
